# Hermes Agent Environment Configuration
# Copy this file to C:\Users\<用户名>\AppData\Local\hermes\.env
# Fill in your API keys below

# =============================================================================
# DEEPSEEK (Cheap primary model — fill this in!)
# =============================================================================
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================================
# ANTHROPIC BASE URL (DeepSeek compatibility — drives Claude Code)
# =============================================================================
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=${DEEPSEEK_API_KEY}
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max

# =============================================================================
# OPENROUTER (Optional — for broader model selection, requires proxy/VPN)
# =============================================================================
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# =============================================================================
# OLLAMA (Local models — optional, uncomment if you have Ollama)
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# KIMI / Moonshot (Alternative Chinese model)
# =============================================================================
# Get your key at: https://platform.moonshot.cn
# KIMI_API_KEY=

# =============================================================================
# DEEPSEEK ADDITIONAL
# =============================================================================
# DEEPSEEK_BASE_URL is set above. Use the correct one for your key type.
